{
  // Production Worker. Staging is the "staging" environment below.
  // Secrets (never in this file): SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY,
  // BRAVE_SEARCH_API_KEY, PAGESPEED_API_KEY, LEAD_EMAIL_SMTP_USER, LEAD_EMAIL_SMTP_PASSWORD,
  // UNSUBSCRIBE_SECRET (same value as BWE).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growth-intelligence",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One cron for the dispatcher (src/tasks/dispatch.ts). Needs Workers Paid:
  // the account's free plan is at its 5-trigger limit.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Production address. Wrangler creates the DNS record when this Worker is deployed,
  // as long as businesswebexpress.com is a zone in the same Cloudflare account.
  "routes": [{ "pattern": "growthintelligence.businesswebexpress.com", "custom_domain": true }],
  "vars": {
    // GIE's own tables, and the BWE schema it reads (read-only) in the same environment.
    "GIE_DB_SCHEMA": "gie_prod",
    "BWE_DB_SCHEMA": "public",
    "BWE_TENANT_SLUG": "bwe",
    "GIE_CLASSIFY_MODEL": "claude-opus-5-5"
  },
  "env": {
    "staging": {
      "name": "growth-intelligence-staging",
      // "routes" is inherited from the top level unless set here. Without this empty list every
      // staging deploy took over the production address (growthintelligence.businesswebexpress.com).
      "routes": [],
      "workers_dev": true,
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "GIE_DB_SCHEMA": "gie_staging",
        "BWE_DB_SCHEMA": "bwe_staging",
        "BWE_TENANT_SLUG": "bwe",
        "GIE_CLASSIFY_MODEL": "claude-opus-5-5"
      }
    }
  }
}
